<% content_for :title, "#{@hotel.name} — Hospello" %>

<p class="mb-4">
  <%= link_to "← Back to hotels", platform_hotels_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
</p>

<div class="mb-6 flex items-start justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900"><%= @hotel.name %></h1>
    <p class="mt-1 text-sm text-gray-600">
      /h/<%= @hotel.slug %> &middot; <%= @hotel.timezone %> &middot; staff language: <%= @hotel.staff_locale %>
    </p>
  </div>

  <% if @hotel.active? %>
    <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-sm font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
  <% else %>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Suspended</span>
  <% end %>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="rounded-lg border border-gray-200 bg-white p-6">
      <h2 class="text-sm font-medium text-gray-600">Platform switches</h2>
      <dl class="mt-3 grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-gray-500">Powered-by badge</dt>
          <dd class="font-medium text-gray-900"><%= @hotel.powered_by_visible? ? "Visible to guests" : "Hidden" %></dd>
        </div>
        <div>
          <dt class="text-gray-500">AI concierge</dt>
          <dd class="font-medium text-gray-900"><%= @hotel.ai_enabled? ? "Enabled" : "Disabled" %></dd>
        </div>
        <div>
          <dt class="text-gray-500">Daily AI token budget</dt>
          <dd class="font-medium text-gray-900"><%= number_with_delimiter(@hotel.ai_daily_token_budget) %></dd>
        </div>
        <div>
          <dt class="text-gray-500">Escalation email</dt>
          <dd class="font-medium text-gray-900"><%= @hotel.escalation_email.presence || "Not set" %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-lg border border-gray-200 bg-white p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-medium text-gray-600">Administrators</h2>
        <%= link_to (@admins.any? ? "Add another admin" : "Create first admin"),
              new_platform_hotel_hotel_admin_path(@hotel), class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
      </div>

      <% if @admins.any? %>
        <ul class="mt-3 divide-y divide-gray-100 text-sm">
          <% @admins.each do |admin| %>
            <li class="flex items-center justify-between py-2">
              <div>
                <div class="font-medium text-gray-900"><%= admin.name %></div>
                <div class="text-gray-500"><%= admin.email_address %></div>
              </div>
              <span class="text-gray-500"><%= admin.active? ? "Active" : "Deactivated" %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-gray-600">No admin yet — this hotel cannot be handed over until one exists.</p>
      <% end %>
    </section>
  </div>

  <div class="space-y-4">
    <div class="rounded-lg border border-gray-200 bg-white p-6">
      <h2 class="text-sm font-medium text-gray-600">Staff</h2>
      <p class="mt-1 text-2xl font-semibold text-gray-900"><%= @staff_count %></p>
    </div>

    <div class="flex flex-col gap-3">
      <%= link_to "Edit hotel", edit_platform_hotel_path(@hotel),
            class: "rounded-md border border-gray-400 px-4 py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50" %>

      <% if @hotel.active? %>
        <%= button_to "Suspend hotel", suspend_platform_hotel_path(@hotel), method: :patch,
              class: "w-full rounded-md border border-amber-300 px-4 py-2.5 text-sm font-medium text-amber-700 hover:bg-amber-50 cursor-pointer" %>
      <% else %>
        <%= button_to "Reactivate hotel", activate_platform_hotel_path(@hotel), method: :patch,
              class: "w-full rounded-md border border-green-300 px-4 py-2.5 text-sm font-medium text-green-700 hover:bg-green-50 cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
