<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<%= form_with model: [ :platform, hotel ], class: "space-y-6" do |form| %>
  <% if hotel.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4">
      <p class="font-medium text-red-700"><%= pluralize(hotel.errors.count, "error") %> prevented this hotel from being saved:</p>
      <ul class="mt-2 list-inside list-disc text-sm text-red-700">
        <% hotel.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, required: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :slug, class: "block text-sm font-medium text-gray-700" %>
    <p class="text-sm text-gray-500">The address a guest's QR code points at: /h/&lt;slug&gt;. Leave blank to derive it from the name.</p>
    <%= form.text_field :slug, class: field_classes %>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :timezone, "Time zone", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-sm text-gray-500">An IANA identifier, e.g. Europe/Sarajevo.</p>
      <%= form.text_field :timezone, required: true, class: field_classes %>
    </div>

    <div>
      <%= form.label :staff_locale, "Staff language", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-sm text-gray-500">The language the staff dashboard itself is shown in.</p>
      <%= form.select :staff_locale, options_for_select([ [ "English", "en" ], [ "Bosnian", "bs" ] ], hotel.staff_locale), {}, class: field_classes %>
    </div>
  </div>

  <%# Only when the hotel does not exist yet. A hotel has to be born with a plan
      and there is no prior state to audit against; every later change goes
      through #plan on the show page, which writes its own audit row. Offering
      it here on edit as well would give plan changes two doors, one of them
      unlogged.

      Preselected to Essentials — that is the plan being sold. The column
      default is `service` for a different reason (see the migration): it means
      "the app as built", so the eighteen tests that create a Hotel inline
      without naming a plan keep the product they were written against. %>
  <% if hotel.new_record? %>
    <div>
      <%= form.label :plan, "Plan", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :plan,
            options_for_select(Hotel.plans.keys.map { |p| [ p.capitalize, p ] }, hotel.plan || "essentials"),
            {},
            class: field_classes %>
    </div>
  <% end %>

  <fieldset class="space-y-4 rounded-lg border border-gray-200 p-4">
    <legend class="px-1 text-sm font-medium text-gray-700">Platform switches</legend>
    <p class="text-sm text-gray-500">Set here only — never offered on the hotel's own settings form.</p>

    <div class="flex items-start gap-3">
      <%= form.check_box :powered_by_visible, class: "mt-1" %>
      <%= form.label :powered_by_visible, "Show “Powered by Hospello” to guests", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-start gap-3">
      <%= form.check_box :ai_enabled, class: "mt-1" %>
      <%= form.label :ai_enabled, "AI concierge enabled", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div>
      <%= form.label :ai_daily_token_budget, "Daily AI token budget", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :ai_daily_token_budget, min: 0, class: field_classes %>
    </div>
  </fieldset>

  <div>
    <%= form.label :escalation_email, "Escalation email", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-sm text-gray-500">Where overdue guest requests get escalated.</p>
    <%= form.email_field :escalation_email, class: field_classes %>
  </div>

  <div>
    <%= form.submit submit_label, class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>
