<% content_for :title, "New admin for #{@hotel.name} — Hospello" %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<p class="mb-4">
  <%= link_to "← Back to #{@hotel.name}", platform_hotel_path(@hotel), class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
</p>

<div class="mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Create an admin for <%= @hotel.name %></h1>
  <p class="mt-1 text-sm text-gray-600">
    Type a name, email and password now — Hospello sends no email in this version, so hand these
    credentials to the hotel directly during your call or visit.
  </p>
</div>

<% if @user.errors.any? %>
  <div class="mb-6 max-w-lg rounded-lg bg-red-50 p-4">
    <p class="font-medium text-red-700"><%= pluralize(@user.errors.count, "error") %> prevented this admin from being created:</p>
    <ul class="mt-2 list-inside list-disc text-sm text-red-700">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# Plain navigation, not a Turbo fetch — see _form.html.erb for the same call
    on the hotel form and sessions/new.html.erb for the original precedent. %>
<%= form_with model: @user, url: platform_hotel_hotel_admins_path(@hotel), class: "max-w-lg space-y-6", data: { turbo: false } do |form| %>
  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, required: true, autofocus: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-gray-700" %>
    <%= form.email_field :email_address, required: true, autocomplete: "off", class: field_classes %>
  </div>

  <div>
    <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
  </div>

  <%= form.submit "Create admin", class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
<% end %>
