<% content_for :title, "Analytics — Hospello" %>
<%# English only, like the rest of this namespace: platform admins are
    Hospello's own people, not a hotel's staff. %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">Analytics</h1>
    <%# Each hotel clamps the range against its *own* calendar, so a page
        spanning timezones can legitimately show rows covering slightly
        different days. Stated as the requested range rather than invented as
        a single authoritative one. %>
    <p id="analytics-range" class="mt-1 text-sm text-gray-600">
      <%= @reports.any? ? "#{@reports.first.days} days to #{@reports.first.to.to_fs(:long)}" : "No hotels yet" %>
    </p>
  </div>

  <nav class="flex gap-2 text-sm">
    <% { 7 => "7 days", 30 => "30 days", 90 => "90 days" }.each do |days, label| %>
      <%= link_to label, platform_analytics_path(from: Date.current - (days - 1), to: Date.current),
            class: [ "rounded-md border px-3 py-1.5 font-medium",
                     @reports.first&.days == days ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-700 hover:bg-gray-50" ] %>
    <% end %>
  </nav>
</div>

<% if @reports.empty? %>
  <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
    <p class="text-gray-600">No hotels yet — create the first one.</p>
  </div>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left font-medium text-gray-600">Hotel</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Guests</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Conversations</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Handed over</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Requests</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Unanswered</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">AI failures</th>
          <th class="px-4 py-3 text-right font-medium text-gray-600">Tokens</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @reports.each do |report| %>
          <tr id="<%= dom_id(report.hotel, :analytics) %>">
            <td class="px-4 py-3">
              <%= link_to report.hotel.name, platform_hotel_path(report.hotel),
                    class: "font-medium text-blue-700 hover:text-blue-900" %>
              <%# A suspended hotel stays on this page on purpose: "which
                  hotels stopped using it" is exactly what this screen is for,
                  and dropping them would hide the only number that matters
                  commercially. %>
              <% if report.hotel.suspended? %>
                <span class="ml-1 rounded-full bg-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-700">Suspended</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right"><%= report.guests %></td>
            <td class="px-4 py-3 text-right"><%= report.conversations %></td>
            <td class="px-4 py-3 text-right">
              <%= report.escalated %>
              <% if report.escalation_rate %>
                <span class="text-xs text-gray-500"><%= number_to_percentage(report.escalation_rate * 100, precision: 0) %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right"><%= report.requests %></td>
            <td class="px-4 py-3 text-right"><%= report.unanswered_questions %></td>
            <td class="px-4 py-3 text-right <%= "font-semibold text-red-700" if report.ai_failures.positive? %>">
              <%= report.ai_failures %>
            </td>
            <%# Tokens appear here and not on the hotel's own page: here they
                really are the cost driver. A hotel pays Hospello and cannot
                act on a token count; Hospello pays per token. %>
            <td class="px-4 py-3 text-right"><%= number_with_delimiter(report.tokens) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="border-t-2 border-gray-200 bg-gray-50 font-medium">
        <tr id="analytics-totals">
          <td class="px-4 py-3">All hotels</td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:guests) %></td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:conversations) %></td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:escalated) %></td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:requests) %></td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:unanswered_questions) %></td>
          <td class="px-4 py-3 text-right"><%= @reports.sum(&:ai_failures) %></td>
          <td class="px-4 py-3 text-right"><%= number_with_delimiter(@reports.sum(&:tokens)) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>
