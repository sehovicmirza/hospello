<%# Two separate forms, not one form with a toggle. A toggle is a piece of
    state that can be left in the wrong position by the previous message,
    by a page morph, or by a receptionist who glanced away — and the cost
    of it being wrong is an internal note delivered to the guest, or a
    reply the guest never receives. Two forms, each with its own fixed
    `kind` and its own colour, cannot be in the wrong mode: the button you
    press is the decision.

    data-turbo-permanent on both textareas: this page morphs itself
    whenever anything happens in the conversation (see show.html.erb), and
    a half-typed reply must survive that. Each needs a stable id for Turbo
    to match it across the morph. %>
<div class="mt-6 grid gap-4 lg:grid-cols-2">
  <section class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-gray-900"><%= t(".reply_heading") %></h2>
    <p id="reply-destination" class="mt-1 text-xs text-gray-600">
      <%= t(".reply_destination_html", name: content_tag(:span, conversation.guest_session.guest_name, dir: "auto")) %>
      <% if conversation.guest_locale.present? %>
        <%= t(".reading_in", locale: conversation.guest_locale) %>
      <% end %>
    </p>

    <%= form_with url: staff_conversation_messages_path(conversation), method: :post, id: "reply-form", class: "mt-3" do %>
      <%= hidden_field_tag :kind, Staff::MessagesController::REPLY %>
      <%= text_area_tag "message[body]", nil, rows: 3, id: "reply-body", dir: "auto",
            maxlength: Message::MAX_BODY_LENGTH, required: true,
            data: { turbo_permanent: true },
            placeholder: t(".reply_placeholder"),
            class: "block w-full rounded-md border border-gray-400 px-3 py-2 text-sm shadow-sm focus:outline-blue-600" %>
      <%= submit_tag t(".reply_send"), id: "reply-send",
            class: "mt-2 cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </section>

  <section class="rounded-lg border-2 border-dashed border-purple-300 bg-purple-50 p-4">
    <h2 class="flex items-center gap-1.5 text-sm font-semibold text-purple-900">
      <span aria-hidden="true">🔒</span> <%= t(".internal_note_heading") %>
    </h2>
    <p id="note-destination" class="mt-1 text-xs text-purple-800">
      <%= t(".internal_note_destination") %>
    </p>

    <%= form_with url: staff_conversation_messages_path(conversation), method: :post, id: "internal-note-form", class: "mt-3" do %>
      <%= hidden_field_tag :kind, Staff::MessagesController::INTERNAL_NOTE %>
      <%= text_area_tag "message[body]", nil, rows: 3, id: "note-body", dir: "auto",
            maxlength: Message::MAX_BODY_LENGTH, required: true,
            data: { turbo_permanent: true },
            placeholder: t(".internal_note_placeholder"),
            class: "block w-full rounded-md border border-purple-400 bg-white px-3 py-2 text-sm shadow-sm focus:outline-purple-600" %>
      <%= submit_tag t(".internal_note_save"), id: "note-save",
            class: "mt-2 cursor-pointer rounded-md bg-purple-700 px-4 py-2 text-sm font-medium text-white hover:bg-purple-600" %>
    <% end %>
  </section>
</div>
