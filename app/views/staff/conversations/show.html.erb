<% content_for :title, t(".title", guest_name: @conversation.guest_session.guest_name) %>

<%# Same morphing refresh as the inbox list: a new guest message
    broadcasts a refresh to [hotel, :inbox] and this page re-renders from
    the server. The composer below is data-turbo-permanent so a half-typed
    reply survives that morph — a receptionist losing a sentence every time
    the guest sends another one would make this screen unusable in exactly
    the moments it matters most. %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div data-controller="inbox-resilience">
  <%= turbo_stream_from Current.hotel, :inbox, channel: HotelInboxChannel,
        data: { inbox_resilience_target: "source" } %>

  <%= link_to t(".back_to_inbox"), staff_conversations_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>

  <header id="conversation-header" class="mt-3 mb-6 flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-semibold text-gray-900" dir="auto">
          <%= @conversation.guest_session.guest_name %>
        </h1>
        <%= guest_identity_badge(@conversation.guest_session) %>
      </div>

      <p class="text-sm text-gray-600">
        <%= @conversation.room ? t("staff.common.room.given", number: @conversation.room.number) : t("staff.common.room.none") %>
        ·
        <%= @conversation.web? ? t("staff.common.channel.web") : t("staff.common.channel.whatsapp") %>
        ·
        <%= t(".guest_language", locale: @conversation.guest_locale.presence || t(".guest_language_unknown")) %>
        ·
        <%= t(".status_label") %> <span id="conversation-status"><%= staff_conversation_status_label(@conversation) %></span>
      </p>

      <%# The room number came from the guest, on a QR code anyone in the
          lobby can scan. Saying so once, in a sentence, next to the badge
          that abbreviates it — this is the product's honesty about
          identity, not a tooltip. %>
      <p class="text-xs text-gray-500">
        <%= t(".identity_notice") %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%# Nothing reads ai_mode until Slice 3 adds the concierge; the
          control and the trail it writes belong with the inbox that
          operates it. The label says what will happen, not what is
          currently true. %>
      <% if policy(@conversation).toggle_ai? %>
        <%= button_to (@conversation.paused? ? t(".return_to_assistant") : t(".take_over")),
              ai_mode_staff_conversation_path(@conversation), method: :patch, id: "ai-mode-toggle",
              class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
      <% end %>

      <% if policy(@conversation).resolve? && @conversation.live? %>
        <%= button_to t(".mark_resolved"), resolve_staff_conversation_path(@conversation), method: :patch,
              id: "resolve-conversation",
              class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
      <% end %>
    </div>
  </header>

  <% if @conversation.paused? %>
    <p id="ai-paused-notice" class="mb-4 rounded-md bg-blue-50 px-3 py-2 text-sm text-blue-800">
      <%= t(".ai_paused_notice") %>
    </p>
  <% end %>

  <div id="transcript" class="flex flex-col gap-3 rounded-lg border border-gray-200 bg-white p-4">
    <% if @messages.empty? %>
      <p id="transcript-empty" class="text-sm text-gray-500"><%= t(".no_messages") %></p>
    <% else %>
      <%= render partial: "staff/conversations/message", collection: @messages, as: :message %>
    <% end %>
  </div>

  <%= render "staff/conversations/composer", conversation: @conversation %>
</div>
