<% content_for :title, "Inbox — #{Current.hotel.name}" %>

<%# Turbo 8 morphing page refresh is how this screen stays live: a new
    message broadcasts a refresh to [hotel, :inbox] (Conversation#broadcast_new_message),
    Turbo re-fetches this page and morphs it in, and every count on it is
    therefore recomputed by the server rather than nudged in the browser.
    Scroll preservation matters because a receptionist reading down a long
    queue must not be thrown back to the top every time an unrelated guest
    sends a message. %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div data-controller="inbox-resilience">
  <%= turbo_stream_from Current.hotel, :inbox, channel: HotelInboxChannel,
        data: { inbox_resilience_target: "source" } %>

  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-gray-900">Inbox</h1>

    <p id="inbox-connection-notice" class="hidden rounded-md bg-amber-50 px-3 py-1.5 text-sm text-amber-800"
       role="status" data-inbox-resilience-target="offlineBanner">
      Live updates are offline — this page is refreshing itself every minute instead.
    </p>
  </div>

  <nav id="inbox-filters" class="mb-4 flex flex-wrap gap-2" aria-label="Filter conversations">
    <% Staff::ConversationsController::FILTERS.each_key do |filter| %>
      <%# Each tab keeps the current search, so switching lens does not
          silently throw away what the receptionist typed. %>
      <%= link_to staff_conversations_path(filter: filter, q: @query.presence),
            id: "filter-#{filter}",
            "aria-current": (filter == @filter ? "page" : nil),
            class: [ "rounded-full border px-3 py-1.5 text-sm font-medium",
                     filter == @filter ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-600 hover:bg-gray-100" ] do %>
        <%= { all: "All", needs_attention: "Needs attention", resolved: "Resolved" }.fetch(filter) %>
        <span class="ml-1 text-xs text-gray-500"><%= @counts.fetch(filter) %></span>
      <% end %>
    <% end %>
  </nav>

  <%= form_with url: staff_conversations_path, method: :get, id: "inbox-search",
        class: "mb-6 flex gap-2" do %>
    <%= hidden_field_tag :filter, @filter %>
    <%= search_field_tag :q, @query, placeholder: "Search guest name or room number",
          class: "w-full max-w-sm rounded-md border border-gray-400 px-3 py-2 text-sm shadow-sm focus:outline-blue-600" %>
    <%= submit_tag "Search", class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
    <% if @query.present? %>
      <%= link_to "Clear", staff_conversations_path(filter: @filter),
            class: "rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100" %>
    <% end %>
  <% end %>

  <% if @conversations.any? %>
    <ul id="conversation-list" class="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white">
      <%= render partial: "staff/conversations/conversation_row", collection: @conversations, as: :conversation %>
    </ul>
  <% else %>
    <div id="inbox-empty" class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <p class="text-gray-600">
        <% if @query.present? %>
          No conversations match “<%= @query %>”.
        <% else %>
          No conversations in this view yet. They appear here the moment a guest sends their first message.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
