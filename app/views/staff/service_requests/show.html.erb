<% content_for :title, t(".title", summary: @request.summary) %>

<%= link_to t(".back"), staff_service_requests_path,
      class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>

<div class="mt-3 mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900" dir="auto"><%= render "staff/service_requests/summary", request: @request %></h1>
    <p class="mt-1 text-sm text-gray-600">
      <%= t(".room_line", number: @request.room&.number || t(".no_room")) %> ·
      <%= @request.guest_session&.guest_name %>
      <%= guest_identity_badge(@request.guest_session) if @request.guest_session %>
    </p>
  </div>

  <span class="rounded-full px-3 py-1 text-sm font-semibold <%= staff_request_status_classes(@request) %>">
    <%= staff_request_status_label(@request) %>
  </span>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="lg:col-span-2 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-sm font-medium text-gray-600"><%= t(".what_was_asked") %></h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500"><%= t(".kind_label") %></dt>
        <dd class="font-medium text-gray-900"><%= @request.request_category.name %></dd>
      </div>
      <% @request.details.each do |field, value| %>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-500"><%= staff_detail_field_label(field) %></dt>
          <dd class="font-medium text-gray-900" dir="auto"><%= value %></dd>
        </div>
      <% end %>
      <% if @request.requested_for_at %>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-500"><%= t(".wanted_for_label") %></dt>
          <dd class="font-medium text-gray-900"><%= staff_time(@request.requested_for_at).strftime("%-d %b, %H:%M") %></dd>
        </div>
      <% end %>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500"><%= t(".raised_label") %></dt>
        <dd class="font-medium text-gray-900"><%= staff_time(@request.created_at).strftime("%-d %b, %H:%M") %></dd>
      </div>
    </dl>

    <% if @request.conversation %>
      <%= link_to t(".open_conversation"), staff_conversation_path(@request.conversation),
            class: "mt-4 inline-block text-sm font-medium text-blue-600 hover:text-blue-500" %>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-sm font-medium text-gray-600"><%= t(".whats_next") %></h2>

    <%# Only the transitions this request can actually make, from the table on
        the model. Rendering a button that would be refused is how a
        receptionist learns to distrust the screen. %>
    <div id="request-transitions" class="mt-3 flex flex-col gap-2">
      <% staff_request_transitions(@request).each do |to, label| %>
        <%= button_to label, transition_staff_service_request_path(@request, to: to), method: :patch,
              id: "transition-#{to}",
              class: "w-full cursor-pointer rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-100" %>
      <% end %>
      <% if staff_request_transitions(@request).empty? %>
        <p class="text-sm text-gray-500"><%= t(".nothing_further") %></p>
      <% end %>
    </div>
  </section>
</div>

<section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
  <h2 class="text-sm font-medium text-gray-600"><%= t(".history") %></h2>

  <%# Said in words on the form itself, not only in a policy file: this is
      where a receptionist writes something frank about a guest, and the one
      question they need answered before typing is who can read it. %>
  <%= form_with url: staff_service_request_request_events_path(@request), id: "request-note-form",
        class: "mt-3 flex flex-wrap items-start gap-2" do %>
    <%= text_field_tag :note, nil, id: "request-note", placeholder: t(".note_placeholder"),
          class: "w-full max-w-md rounded-md border border-gray-400 px-3 py-2 text-sm shadow-sm focus:outline-blue-600" %>
    <%= submit_tag t(".note_save"), id: "request-note-save",
          class: "cursor-pointer rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
  <% end %>
  <ul id="request-history" class="mt-3 space-y-2 text-sm">
    <% @events.each do |event| %>
      <li id="<%= dom_id(event) %>" class="flex flex-wrap gap-2 text-gray-700">
        <span class="text-gray-400"><%= staff_time(event.created_at).strftime("%-d %b, %H:%M") %></span>
        <span><%= staff_request_event_sentence(event) %></span>
        <% if event.note.present? %>
          <span class="text-gray-500" dir="auto">— <%= event.note %></span>
        <% end %>
      </li>
    <% end %>
    <% if @events.empty? %>
      <li class="text-gray-500"><%= t(".note_nothing_yet") %></li>
    <% end %>
  </ul>
</section>
