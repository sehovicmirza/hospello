<% content_for :title, t(".title", hotel_name: Current.hotel.name) %>

<%# Live the same way the inbox is: a status change broadcasts a refresh to
    [hotel, :requests] (ServiceRequest#broadcast_board), Turbo re-fetches this
    page and morphs it in, and every count is therefore recomputed by the
    server rather than nudged in the browser. Scroll preservation matters
    because a receptionist working down a queue must not be thrown back to
    the top each time an unrelated guest confirms something. %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div data-controller="inbox-resilience">
  <%= turbo_stream_from Current.hotel, :requests, channel: HotelRequestsChannel,
        data: { inbox_resilience_target: "source" } %>

  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".heading") %></h1>

    <p id="requests-connection-notice" class="hidden rounded-md bg-amber-50 px-3 py-1.5 text-sm text-amber-800"
       role="status" data-inbox-resilience-target="offlineBanner">
      <%= t(".offline_banner") %>
    </p>
  </div>

  <nav id="request-filters" class="mb-4 flex flex-wrap gap-2" aria-label="Filter requests">
    <% { open: t(".filters.open"), all: t(".filters.all"), settled: t(".filters.settled") }.each do |filter, label| %>
      <%# Each tab keeps the current search and category, so switching lens
          does not silently throw away what the receptionist typed. %>
      <%= link_to staff_service_requests_path(filter: filter, q: @query.presence, category_id: params[:category_id].presence),
            id: "request-filter-#{filter}",
            "aria-current": (filter == @filter ? "page" : nil),
            class: [ "rounded-full border px-3 py-1.5 text-sm font-medium",
                     filter == @filter ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-600 hover:bg-gray-100" ] do %>
        <%= label %>
        <% if filter == :open %>
          <span class="ml-1 text-xs text-gray-500"><%= @counts.fetch(:open) %></span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <%= form_with url: staff_service_requests_path, method: :get, id: "request-search", class: "mb-4 flex flex-wrap gap-2" do %>
    <%= hidden_field_tag :filter, @filter %>
    <%= search_field_tag :q, @query, placeholder: t(".search_placeholder"),
          class: "w-full max-w-sm rounded-md border border-gray-400 px-3 py-2 text-sm shadow-sm focus:outline-blue-600" %>
    <%= select_tag :category_id,
          options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
          include_blank: t(".category_blank"),
          class: "rounded-md border border-gray-400 px-3 py-2 text-sm shadow-sm focus:outline-blue-600" %>
    <%= submit_tag t(".search"), class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
    <% if @query.present? || params[:category_id].present? %>
      <%= link_to t(".clear"), staff_service_requests_path(filter: @filter),
            class: "rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100" %>
    <% end %>
  <% end %>

  <% if @requests.any? %>
    <ul id="request-board" class="grid gap-3 sm:grid-cols-2">
      <%= render partial: "staff/service_requests/card", collection: @requests, as: :request %>
    </ul>
  <% else %>
    <div id="request-board-empty" class="rounded-lg border border-dashed border-gray-300 p-10 text-center">
      <p class="text-gray-700">
        <%= @query.present? || params[:category_id].present? ? t(".no_match") : t(".nothing_waiting") %>
      </p>
      <p class="mx-auto mt-1 max-w-md text-sm text-gray-600">
        <%= t(".empty_hint") %>
      </p>
    </div>
  <% end %>
</div>
