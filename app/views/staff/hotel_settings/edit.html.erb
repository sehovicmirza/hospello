<% content_for :title, t(".title", hotel_name: @hotel.name) %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<h1 class="mb-6 text-2xl font-semibold text-gray-900"><%= t(".heading") %></h1>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-3" data-controller="brand-preview">
  <div class="lg:col-span-2">
    <%= form_with model: @hotel, url: staff_hotel_settings_path, method: :patch, multipart: true, class: "space-y-6" do |form| %>
      <% if @hotel.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4">
          <p class="font-medium text-red-700"><%= t(".errors_heading", count: @hotel.errors.count) %></p>
          <ul class="mt-2 list-inside list-disc text-sm text-red-700">
            <% @hotel.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset class="space-y-4 rounded-lg border border-gray-200 p-4">
        <legend class="px-1 text-sm font-medium text-gray-700"><%= t(".identity_legend") %></legend>

        <div>
          <%= form.label :name, t(".name_label"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name, required: true, class: field_classes %>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :timezone, t(".timezone_label"), class: "block text-sm font-medium text-gray-700" %>
            <p class="text-sm text-gray-500"><%= t(".timezone_hint") %></p>
            <%= form.text_field :timezone, required: true, class: field_classes %>
          </div>

          <div>
            <%= form.label :staff_locale, t(".staff_locale_label"), class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :staff_locale, options_for_select([ [ t("staff.common.locales.en"), "en" ], [ t("staff.common.locales.bs"), "bs" ] ], @hotel.staff_locale), {}, class: field_classes %>
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4 rounded-lg border border-gray-200 p-4">
        <legend class="px-1 text-sm font-medium text-gray-700"><%= t(".branding_legend") %></legend>
        <p class="text-sm text-gray-500"><%= t(".branding_hint") %></p>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :primary_color, t(".primary_color_label"), class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 flex items-center gap-2">
              <span class="h-8 w-8 flex-shrink-0 rounded border border-gray-300"
                    data-brand-preview-target="primarySwatch" style="background-color:<%= @hotel.primary_color %>"></span>
              <%= form.text_field :primary_color, required: true, pattern: "#[0-9A-Fa-f]{6}",
                    data: { brand_preview_target: "primaryInput", action: "input->brand-preview#update" },
                    class: field_classes %>
            </div>
          </div>

          <div>
            <%= form.label :secondary_color, t(".secondary_color_label"), class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1 flex items-center gap-2">
              <span class="h-8 w-8 flex-shrink-0 rounded border border-gray-300"
                    data-brand-preview-target="secondarySwatch" style="background-color:<%= @hotel.secondary_color %>"></span>
              <%= form.text_field :secondary_color, required: true, pattern: "#[0-9A-Fa-f]{6}",
                    data: { brand_preview_target: "secondaryInput", action: "input->brand-preview#update" },
                    class: field_classes %>
            </div>
          </div>
        </div>

        <div>
          <%= form.label :logo, t(".logo_label"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t(".logo_hint") %></p>
          <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp,image/svg+xml",
                data: { brand_preview_target: "logoInput", action: "change->brand-preview#updateLogo" },
                class: "mt-1 block w-full text-sm text-gray-700" %>
        </div>

        <div>
          <%= form.label :welcome_image, t(".welcome_image_label"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t(".welcome_image_hint") %></p>
          <%= form.file_field :welcome_image, accept: "image/png,image/jpeg,image/webp", class: "mt-1 block w-full text-sm text-gray-700" %>
          <% if displayable_attachment?(@hotel.welcome_image) %>
            <%= image_tag @hotel.welcome_image, class: "mt-2 h-20 rounded object-cover", alt: "" %>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="space-y-4 rounded-lg border border-gray-200 p-4">
        <legend class="px-1 text-sm font-medium text-gray-700"><%= t(".guest_info_legend") %></legend>

        <div>
          <%= form.label :concierge_name, t(".concierge_name_label"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t(".concierge_name_hint") %></p>
          <%= form.text_field :concierge_name, class: field_classes %>
        </div>

        <div>
          <%= form.label :welcome_message, t(".welcome_message_label"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :welcome_message, rows: 3, class: field_classes %>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :contact_phone, t(".contact_phone_label"), class: "block text-sm font-medium text-gray-700" %>
            <%= form.telephone_field :contact_phone, class: field_classes %>
          </div>

          <div>
            <%= form.label :checkout_time, t(".checkout_time_label"), class: "block text-sm font-medium text-gray-700" %>
            <p class="text-sm text-gray-500"><%= t(".checkout_time_hint") %></p>
            <%= form.text_field :checkout_time, class: field_classes %>
          </div>
        </div>

        <div>
          <%= form.label :contact_notes, t(".contact_notes_label"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t(".contact_notes_hint") %></p>
          <%= form.text_area :contact_notes, rows: 2, class: field_classes %>
        </div>
      </fieldset>

      <fieldset class="space-y-4 rounded-lg border border-gray-200 p-4">
        <legend class="px-1 text-sm font-medium text-gray-700"><%= t(".escalation_legend") %></legend>

        <div>
          <%= form.label :escalation_email, t(".escalation_email_label"), class: "block text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t(".escalation_email_hint") %></p>
          <%= form.email_field :escalation_email, class: field_classes %>
        </div>

        <div>
          <%= form.label :overdue_after_minutes, t(".overdue_after_label"), class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :overdue_after_minutes, min: 1, class: field_classes %>
        </div>
      </fieldset>

      <div>
        <%= form.submit t("staff.common.actions.save_changes"), class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="lg:col-span-1">
    <div class="sticky top-8">
      <h2 class="mb-2 text-sm font-medium text-gray-600"><%= t(".preview_heading") %></h2>
      <p class="mb-3 text-xs text-gray-500"><%= t(".preview_hint") %></p>

      <div class="rounded-xl p-6" data-brand-preview-target="preview"
           style="<%= hotel_brand_style(@hotel) %>background-color:var(--brand-primary);color:var(--brand-on-primary);">
        <div class="flex items-center gap-3">
          <img data-brand-preview-target="logoPreview"
               src="<%= displayable_attachment?(@hotel.logo) ? rails_blob_path(@hotel.logo, only_path: true) : "" %>"
               alt="" class="h-12 w-12 rounded-full bg-white object-contain p-1 <%= "hidden" unless displayable_attachment?(@hotel.logo) %>">
          <div>
            <p class="text-xs uppercase tracking-wide opacity-80"><%= t(".preview_label") %></p>
            <p class="text-lg font-semibold"><%= @hotel.name %></p>
          </div>
        </div>
        <p class="mt-4 text-sm opacity-90"><%= @hotel.welcome_message.presence || t(".preview_default_welcome") %></p>
        <%# An outline, not a filled pill: --brand-on-primary is only ever
            guaranteed readable against --brand-primary. Filling this with
            --brand-secondary would need its own contrast-checked "on-secondary"
            color, which doesn't exist (see the task report's interface note
            for Slice 2) — the accent color reads as a border instead, and the
            text stays on the primary background where on-primary is already
            correct. %>
        <span class="mt-4 inline-block rounded-full border-2 px-3 py-1 text-xs font-medium"
              style="border-color:var(--brand-secondary);color:var(--brand-on-primary)">
          <%= t(".preview_start_chat") %>
        </span>
      </div>
    </div>
  </div>
</div>
