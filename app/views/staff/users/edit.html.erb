<% content_for :title, t(".title", name: @user.name, hotel_name: Current.hotel.name) %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= @user.name %></h1>
  <%= link_to t(".back"), staff_users_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<div class="max-w-md">
  <dl class="mb-6 space-y-2 rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500"><%= t(".email_label") %></dt>
      <dd class="font-medium text-gray-900"><%= @user.email_address %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500"><%= t(".role_label") %></dt>
      <dd class="font-medium text-gray-900"><%= staff_role_label(@user.role) %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500"><%= t(".status_label") %></dt>
      <dd class="font-medium text-gray-900"><%= @user.active? ? t("staff.common.status.active") : t("staff.common.status.inactive") %></dd>
    </div>
  </dl>

  <% if @user.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# A separate form from the activate/deactivate button below, on
      purpose — the same "two forms, not one with a toggle" reasoning
      staff/conversations/_composer.html.erb documents: submitting only
      the field actually being changed means this can never carry a stray
      `active` value along with a language change. Shown for every user,
      including a hotel_admin's own row — they may also change it from
      staff.layout.preferences_link, this is simply the other way in. %>
  <%= form_with model: @user, url: staff_user_path(@user), method: :patch, class: "mb-6 flex items-end gap-3" do |form| %>
    <div class="flex-1">
      <%= form.label :locale, t(".locale_label"), class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :locale,
            options_for_select([ [ t("staff.common.locales.en"), "en" ], [ t("staff.common.locales.bs"), "bs" ] ], @user.locale),
            {}, class: "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>
    <%= form.submit t("staff.common.actions.save_changes"),
          class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>

  <% if @user == Current.user %>
    <p class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-600">
      <%= t(".self_notice") %>
    </p>
  <% else %>
    <%= button_to (@user.active? ? t("staff.common.actions.deactivate") : t("staff.common.actions.activate")), staff_user_path(@user),
          method: :patch, params: { user: { active: !@user.active? } },
          class: "rounded-md px-4 py-2.5 font-medium text-white cursor-pointer " +
                 (@user.active? ? "bg-amber-600 hover:bg-amber-500" : "bg-blue-600 hover:bg-blue-500") %>
  <% end %>
</div>
