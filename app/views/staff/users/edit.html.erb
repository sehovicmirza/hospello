<% content_for :title, "#{@user.name} — #{Current.hotel.name}" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= @user.name %></h1>
  <%= link_to "Back to staff", staff_users_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<div class="max-w-md">
  <dl class="mb-6 space-y-2 rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500">Email</dt>
      <dd class="font-medium text-gray-900"><%= @user.email_address %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500">Role</dt>
      <dd class="font-medium text-gray-900"><%= @user.role.humanize %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-gray-500">Status</dt>
      <dd class="font-medium text-gray-900"><%= @user.active? ? "Active" : "Inactive" %></dd>
    </div>
  </dl>

  <% if @user.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @user == Current.user %>
    <p class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-600">
      You cannot deactivate your own account here — ask another hotel admin.
    </p>
  <% else %>
    <%= button_to (@user.active? ? "Deactivate" : "Activate"), staff_user_path(@user),
          method: :patch, params: { user: { active: !@user.active? } },
          class: "rounded-md px-4 py-2.5 font-medium text-white cursor-pointer " +
                 (@user.active? ? "bg-amber-600 hover:bg-amber-500" : "bg-blue-600 hover:bg-blue-500") %>
  <% end %>
</div>
