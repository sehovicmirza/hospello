<% content_for :title, t(".title", hotel_name: Current.hotel.name) %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t(".heading", hotel_name: Current.hotel.name) %></h1>
  <%= link_to t(".back"), staff_users_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<p class="mb-6 max-w-lg text-sm text-gray-600">
  <%= t(".description") %>
</p>

<% if @user.errors.any? %>
  <div class="mb-6 max-w-lg rounded-lg bg-red-50 p-4">
    <p class="font-medium text-red-700"><%= t(".errors_heading", count: @user.errors.count) %></p>
    <ul class="mt-2 list-inside list-disc text-sm text-red-700">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: staff_users_path, class: "max-w-lg space-y-6" do |form| %>
  <div>
    <%= form.label :name, t(".name_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, required: true, autofocus: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :email_address, t(".email_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.email_field :email_address, required: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :role, t(".role_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :role, [ [ staff_role_label("staff"), "staff" ], [ staff_role_label("hotel_admin"), "hotel_admin" ] ], {}, class: field_classes %>
  </div>

  <div>
    <%= form.label :password, t(".password_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, class: field_classes %>
  </div>

  <div>
    <%= form.label :password_confirmation, t(".password_confirmation_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
  </div>

  <%= form.submit t(".submit"), class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
<% end %>
