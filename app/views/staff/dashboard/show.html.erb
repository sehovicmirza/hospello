<% content_for :title, "Dashboard — #{@hotel.name}" %>

<div class="mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Welcome, <%= Current.user.name %></h1>
  <p class="mt-1 text-sm text-gray-600"><%= @hotel.name %> &middot; <%= @hotel.timezone %></p>
</div>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  <section class="rounded-lg border border-gray-200 bg-white p-6">
    <h2 class="text-sm font-medium text-gray-600">Hotel profile</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Concierge name</dt>
        <dd class="font-medium text-gray-900"><%= @hotel.concierge_name.presence || "Not set" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Staff language</dt>
        <dd class="font-medium text-gray-900"><%= @hotel.staff_locale == "bs" ? "Bosnian" : "English" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Last updated</dt>
        <dd class="font-medium text-gray-900"><%= staff_time(@hotel.updated_at).strftime("%B %-d, %Y at %H:%M %Z") %></dd>
      </div>
    </dl>

    <% if policy(@hotel).edit? %>
      <%= link_to "Edit hotel settings", edit_staff_hotel_settings_path,
            class: "mt-4 inline-block text-sm font-medium text-blue-600 hover:text-blue-500" %>
    <% end %>
  </section>

  <section class="rounded-lg border border-dashed border-gray-300 p-6 text-sm text-gray-500">
    Rooms, staff accounts, the QR code and more arrive here as the workspace grows.
  </section>
</div>
