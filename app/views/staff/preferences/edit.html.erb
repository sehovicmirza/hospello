<% content_for :title, t(".title", hotel_name: Current.hotel.name) %>

<h1 class="mb-6 text-2xl font-semibold text-gray-900"><%= t(".heading") %></h1>

<div class="max-w-md">
  <% if Current.user.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% Current.user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: Current.user, url: staff_preferences_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :locale, t(".locale_label"), class: "block text-sm font-medium text-gray-700" %>
      <p class="text-sm text-gray-500"><%= t(".hint") %></p>
      <%= form.select :locale,
            options_for_select(
              [ [ t("staff.common.locales.en"), "en" ], [ t("staff.common.locales.bs"), "bs" ] ],
              Current.user.locale
            ), {},
            class: "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    </div>

    <%= form.submit t(".save"), class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>
</div>
