<%# A plain textarea, deliberately: this content goes straight into a
    prompt, where markdown and rich-text markup cost tokens and give the
    model formatting to imitate instead of facts to use. The live character
    count is here because the 2000-character cap is a real limit a hotel
    will hit on their longest topic, and discovering it only on submit
    after writing three paragraphs is a bad afternoon. %>
<%= form_with model: entry, url: url, class: "space-y-5" do |form| %>
  <% if entry.errors.any? %>
    <div id="kb-entry-errors" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
      <ul class="list-inside list-disc">
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Carried through the form rather than kept in the URL: a validation
      error re-renders this page as a POST, and a gap that lost its link
      there would be silently left open while the hotel believed they had
      just answered it. %>
  <% if local_assigns[:unanswered_question].present? %>
    <%# hidden_field_tag, not form.hidden_field: this is not an attribute of
        KbEntry and never will be — the link belongs to the question, which
        is the record that owns the decision. %>
    <%= hidden_field_tag "kb_entry[unanswered_question_id]", unanswered_question.id, id: "kb-entry-gap-id" %>
    <div id="answering-gap" class="rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-sm text-blue-900">
      <p class="font-medium"><%= t(".answering_gap") %></p>
      <p class="mt-1"><%= t(".asked_count_question_html", count: unanswered_question.asked_count, question: unanswered_question.question) %></p>
      <% if unanswered_question.question_original.present? %>
        <p class="mt-1 text-blue-800" dir="auto"><%= t(".asked_original_html", question: unanswered_question.question_original) %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, t(".title_label"), class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500"><%= t(".title_hint") %></p>
    <%= form.text_field :title, required: true,
          class: "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :category, t(".category_label"), class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :category,
          KbEntry.categories.keys.map { |category| [ kb_category_label(category), category ] },
          {},
          class: "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div data-controller="character-count">
    <%= form.label :content, t(".content_label"), class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500">
      <%= t(".content_hint") %>
    </p>
    <%= form.text_area :content, rows: 8, required: true, maxlength: KbEntry::MAX_CONTENT_LENGTH,
          data: { character_count_target: "input", action: "input->character-count#update" },
          class: "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    <p class="mt-1 text-xs text-gray-500">
      <span data-character-count-target="output"><%= entry.content.to_s.length %></span>
      <%= t(".content_count_suffix", max: KbEntry::MAX_CONTENT_LENGTH) %>
    </p>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :published, class: "size-4 rounded border-gray-400" %>
    <%= form.label :published, t(".published_label"), class: "text-sm font-medium text-gray-700" %>
    <span class="text-xs text-gray-500"><%= t(".published_hint") %></span>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit t(".save"), class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
    <%= link_to t(".cancel"), staff_kb_entries_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
