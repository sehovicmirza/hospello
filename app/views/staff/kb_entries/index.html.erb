<% content_for :title, "Knowledge base — #{Current.hotel.name}" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">Knowledge base</h1>
    <p class="mt-1 max-w-2xl text-sm text-gray-600">
      This is what the assistant is allowed to tell your guests — and the only thing it will tell them.
      If something isn’t written here, it says it doesn’t know and passes the question to reception
      rather than guessing.
    </p>
  </div>

  <% if policy(KbEntry).create? %>
    <%= link_to "Add an entry", new_staff_kb_entry_path,
          class: "shrink-0 rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
  <% end %>
</div>

<% if @draft_count.positive? %>
  <p id="kb-draft-notice" class="mb-4 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800">
    <%= pluralize(@draft_count, "entry", plural: "entries") %> still in draft — guests can’t see
    <%= @draft_count == 1 ? "it" : "them" %> until you publish.
  </p>
<% end %>

<nav id="kb-categories" class="mb-6 flex flex-wrap gap-2" aria-label="Filter by category">
  <%= link_to "All", staff_kb_entries_path, id: "kb-category-all",
        "aria-current": (@category.nil? ? "page" : nil),
        class: [ "rounded-full border px-3 py-1.5 text-sm font-medium",
                 @category.nil? ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-600 hover:bg-gray-100" ] %>
  <% KbEntry.categories.each_key do |category| %>
    <%= link_to staff_kb_entries_path(category: category), id: "kb-category-#{category}",
          "aria-current": (@category == category ? "page" : nil),
          class: [ "rounded-full border px-3 py-1.5 text-sm font-medium",
                   @category == category ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-600 hover:bg-gray-100" ] do %>
      <%= kb_category_label(category) %>
      <span class="ml-1 text-xs text-gray-500"><%= @counts.fetch(category, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @entries.any? %>
  <ul class="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white">
    <%= render partial: "staff/kb_entries/entry", collection: @entries, as: :entry %>
  </ul>
<% elsif @category %>
  <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
    <p class="text-gray-600">Nothing written down under <%= kb_category_label(@category) %> yet.</p>
  </div>
<% else %>
  <%# Not an empty page: the hardest part of starting a knowledge base is
      the blank sheet, so this offers the topics guests actually ask about
      as one-click starters that open the form already named. %>
  <div class="rounded-lg border border-dashed border-gray-300 p-10 text-center">
    <p class="text-gray-700">Nothing written down yet.</p>
    <p class="mx-auto mt-1 max-w-md text-sm text-gray-600">
      These are what guests ask about most. Start with one — a couple of sentences each is plenty.
    </p>

    <% if policy(KbEntry).create? %>
      <div id="kb-starters" class="mt-5 flex flex-wrap justify-center gap-2">
        <% StaffHelper::KB_STARTERS.each do |starter| %>
          <%= link_to starter[:title], new_staff_kb_entry_path(title: starter[:title], category: starter[:category]),
                class: "rounded-full border border-blue-300 bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-700 hover:bg-blue-100" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
