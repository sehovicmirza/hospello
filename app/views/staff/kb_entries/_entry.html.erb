<%# Draft versus live is the only thing on this row that changes what a
    guest can be told, so it is stated in words rather than implied by a
    colour, and the toggle that changes it sits right next to it. %>
<li id="<%= dom_id(entry) %>" class="flex flex-wrap items-start justify-between gap-4 px-4 py-3">
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-medium text-gray-900"><%= entry.title %></span>

      <% if entry.published? %>
        <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Live</span>
      <% else %>
        <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/30">Draft</span>
      <% end %>

      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
        <%= kb_category_label(entry.category) %>
      </span>
    </div>

    <p class="mt-1 line-clamp-2 text-sm text-gray-600"><%= entry.content %></p>
  </div>

  <div class="flex shrink-0 items-center gap-3">
    <% if policy(entry).publish? %>
      <%= button_to (entry.published? ? "Unpublish" : "Publish"),
            publish_staff_kb_entry_path(entry), method: :patch,
            params: { published: !entry.published? },
            class: [ "cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium",
                     entry.published? ? "text-amber-700 hover:bg-amber-50" : "bg-blue-600 text-white hover:bg-blue-500" ] %>
    <% end %>

    <% if policy(entry).update? %>
      <%= link_to "Edit", edit_staff_kb_entry_path(entry), class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
    <% end %>

    <% if policy(entry).destroy? %>
      <%= button_to "Delete", staff_kb_entry_path(entry), method: :delete,
            form: { data: { turbo_confirm: "Delete “#{entry.title}”?" } },
            class: "cursor-pointer text-sm font-medium text-red-600 hover:text-red-500" %>
    <% end %>
  </div>
</li>
