<% content_for :title, t(".title", hotel_name: Current.hotel.name) %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".heading") %></h1>
    <%# The page says which range it is really showing, in words. It is not
        necessarily the range that was asked for — HotelReport clamps a future
        end date and caps an absurdly wide span — and a page that quietly
        showed something other than what was requested would be the kind of
        wrong nobody catches. %>
    <p id="analytics-range" class="mt-1 text-sm text-gray-600">
      <%= t(".range", from: l(@report.from, format: :long), to: l(@report.to, format: :long), days: @report.days) %>
    </p>
  </div>

  <nav class="flex gap-2 text-sm">
    <% { 7 => t(".last_7"), 30 => t(".last_30"), 90 => t(".last_90") }.each do |days, label| %>
      <%= link_to label, staff_analytics_path(from: Date.current - (days - 1), to: Date.current),
            class: [ "rounded-md border px-3 py-1.5 font-medium",
                     @report.days == days ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-300 text-gray-700 hover:bg-gray-50" ] %>
    <% end %>
  </nav>
</div>

<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  <%= render "staff/analytics/figure", id: "guests-helped", label: t(".guests"), value: @report.guests %>
  <%= render "staff/analytics/figure", id: "guest-messages", label: t(".messages"), value: @report.guest_messages %>
  <%= render "staff/analytics/figure", id: "handled-by-assistant",
        label: t(".handled"), value: @report.handled_by_assistant %>
  <%= render "staff/analytics/figure", id: "handed-over", label: t(".handed_over"), value: @report.escalated,
        note: (number_to_percentage(@report.escalation_rate * 100, precision: 0) if @report.escalation_rate) %>
</div>

<%# The most actionable thing on the page, so it is the largest thing on it and
    it is a list rather than a number: "guests keep asking about parking" tells
    a hotel exactly what to go and write down, which "7 unanswered questions"
    does not. %>
<section id="analytics-gaps" class="mt-8 rounded-lg border border-gray-200 bg-white p-4">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="text-lg font-medium text-gray-900"><%= t(".gaps_heading") %></h2>
    <%= link_to t(".gaps_link"), staff_unanswered_questions_path,
          class: "text-sm font-medium text-blue-700 hover:text-blue-900" %>
  </div>
  <p class="mt-1 text-sm text-gray-600"><%= t(".gaps_intro") %></p>

  <% if @report.top_unanswered.any? %>
    <ul class="mt-3 divide-y divide-gray-100">
      <% @report.top_unanswered.each do |question| %>
        <li class="flex items-start justify-between gap-4 py-2">
          <span class="text-sm text-gray-900" dir="auto"><%= question.question %></span>
          <span class="shrink-0 text-xs font-semibold text-amber-800">
            <%= t(".asked_times", count: question.asked_count) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p id="analytics-gaps-empty" class="mt-3 text-sm text-gray-500"><%= t(".gaps_empty") %></p>
  <% end %>
</section>

<section class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="mb-3 text-lg font-medium text-gray-900"><%= t(".requests_heading") %></h2>
    <dl class="space-y-2 text-sm text-gray-700">
      <div class="flex justify-between gap-4">
        <dt><%= t(".requests_total") %></dt>
        <dd id="requests-total" class="font-medium"><%= @report.requests %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt><%= t(".requests_completed") %></dt>
        <dd id="requests-completed" class="font-medium"><%= @report.requests_completed %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt><%= t(".requests_response") %></dt>
        <dd id="requests-response" class="font-medium">
          <%= @report.median_response_minutes ? t(".minutes", count: @report.median_response_minutes) : t(".no_data") %>
        </dd>
      </div>
      <%# Deliberately not scoped to the range — "what is late" is a question
          about right now, and something that went overdue last month and is
          still sitting there is the most urgent thing on this page. %>
      <div class="flex justify-between gap-4">
        <dt><%= t(".requests_overdue") %></dt>
        <dd id="requests-overdue" class="font-medium <%= "text-red-700" if @report.overdue_now.positive? %>">
          <%= @report.overdue_now %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="mb-3 text-lg font-medium text-gray-900"><%= t(".assistant_heading") %></h2>
    <dl class="space-y-2 text-sm text-gray-700">
      <div class="flex justify-between gap-4">
        <dt><%= t(".assistant_runs") %></dt>
        <dd id="assistant-runs" class="font-medium"><%= @report.ai_runs %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt><%= t(".assistant_failures") %></dt>
        <dd id="assistant-failures" class="font-medium <%= "text-red-700" if @report.ai_failures.positive? %>">
          <%= @report.ai_failures %>
        </dd>
      </div>
      <%# Today's usage against this hotel's own ceiling — the one AI number a
          hotel can act on, because crossing it is what silences the assistant.
          Token totals are the platform's cost driver, not the hotel's: a hotel
          pays Hospello, not per token. %>
      <% if @report.budget_used_fraction %>
        <div class="flex justify-between gap-4">
          <dt><%= t(".assistant_budget") %></dt>
          <dd id="assistant-budget" class="font-medium <%= "text-amber-800" if @report.budget_used_fraction >= 0.9 %>">
            <%= number_to_percentage(@report.budget_used_fraction * 100, precision: 0) %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
