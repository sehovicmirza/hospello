<% content_for :title, "Departments — #{Current.hotel.name}" %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900">Departments</h1>
  <%= link_to "Request categories →", staff_request_categories_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <% if @departments.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Department</th>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Position</th>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Status</th>
              <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @departments.each do |department| %>
              <tr id="<%= dom_id(department) %>">
                <td class="px-4 py-3 font-medium text-gray-900"><%= department.name %></td>
                <td class="px-4 py-3 text-gray-700"><%= department.position %></td>
                <td class="px-4 py-3">
                  <% if department.active? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactive</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-3">
                    <% if policy(department).update? %>
                      <%= link_to "Edit", edit_staff_department_path(department), class: "font-medium text-blue-600 hover:text-blue-500" %>
                      <%= button_to (department.active? ? "Deactivate" : "Activate"), staff_department_path(department),
                            method: :patch, params: { department: { active: !department.active? } },
                            class: "font-medium text-amber-700 hover:text-amber-600 cursor-pointer" %>
                    <% end %>
                    <% if policy(department).destroy? %>
                      <%= button_to "Delete", staff_department_path(department), method: :delete,
                            form: { data: { turbo_confirm: "Delete #{department.name}? This only works while no request category uses it." } },
                            class: "font-medium text-red-600 hover:text-red-500 cursor-pointer" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
        <p class="text-gray-600">No departments yet — add the first one.</p>
      </div>
    <% end %>
  </div>

  <% if policy(Department).create? %>
    <div class="lg:col-span-1">
      <section class="rounded-lg border border-gray-200 bg-white p-4">
        <h2 class="text-sm font-medium text-gray-700">Add a department</h2>

        <% if @department&.errors&.any? %>
          <div class="mt-2 rounded-lg bg-red-50 p-3">
            <ul class="list-inside list-disc text-sm text-red-700">
              <% @department.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @department, url: staff_departments_path, class: "mt-3 space-y-3" do |form| %>
          <div>
            <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :name, class: field_classes %>
          </div>
          <div>
            <%= form.label :position, "Display order", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :position, class: field_classes %>
          </div>
          <%= form.submit "Add department", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 cursor-pointer" %>
        <% end %>
      </section>
    </div>
  <% end %>
</div>
