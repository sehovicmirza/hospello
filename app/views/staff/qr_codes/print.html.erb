<% content_for :title, t(".title", hotel_name: @hotel.name) %>

<% content_for :head do %>
  <style>
    /* Renders this page as a card, not a web page with navigation: hides
       every piece of app chrome the staff layout wraps around it, and sizes
       the sheet for an A5 card rather than a full A4/Letter page. */
    @media print {
      @page { size: A5; margin: 10mm; }

      nav, header, #notice, #alert { display: none !important; }
      body { background: #fff !important; }
      main { max-width: none !important; margin: 0 !important; padding: 0 !important; }
    }
  </style>
<% end %>

<div class="mx-auto max-w-sm rounded-2xl border border-gray-200 bg-white p-8 text-center print:border-0 print:p-0">
  <% if displayable_attachment?(@hotel.logo) %>
    <%= image_tag @hotel.logo, class: "mx-auto mb-4 h-16 object-contain", alt: @hotel.name %>
  <% end %>

  <h1 class="text-xl font-semibold text-gray-900"><%= @hotel.name %></h1>

  <div class="my-6 flex justify-center">
    <%= raw @qr_code.svg(size: 300, standalone: false) %>
  </div>

  <%# text-start, not text-left: a logical (direction-aware) alignment
      property, so it inherits as "align to the start of reading order" —
      left for the bs/en blocks below, right for the Arabic block, which
      also carries dir="rtl". A physical text-left here would have left the
      Arabic paragraph's dir="rtl" fixing bidi *character* order while the
      whole block still hugged the left edge — correct ordering, wrong
      alignment, visibly wrong to an Arabic reader on a printed card
      (review round 1 finding).

      The lines themselves come from QrCardHelper, because what this card may
      honestly promise depends on the hotel's plan: on Essentials, scanning the
      code does not reach the front desk. %>
  <div id="language-lines" class="space-y-4 text-start text-sm text-gray-800">
    <%# tag.div rather than a literal <div>: `dir` has to be absent for the
        left-to-right blocks, not present-and-empty, and Rails drops a nil
        attribute for us. %>
    <% qr_card_lines(@hotel).each do |line| %>
      <%= tag.div(lang: line.lang, dir: line.dir) do %>
        <p class="font-semibold"><%= line.heading %></p>
        <p><%= line.body %></p>
      <% end %>
    <% end %>
  </div>

  <% if @hotel.contact_phone.present? %>
    <p id="reception-phone" class="mt-6 text-sm text-gray-600">Reception: <%= @hotel.contact_phone %></p>
  <% end %>

  <% if @hotel.powered_by_visible? %>
    <p id="powered-by" class="mt-4 text-xs text-gray-400">Powered by Hospello</p>
  <% end %>
</div>
