<% content_for :title, "Edit #{@category.name} — #{Current.hotel.name}" %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900">Edit <%= @category.name %></h1>
  <%= link_to "Back to request categories", staff_request_categories_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<div class="max-w-md">
  <% if @category.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% @category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @category, url: staff_request_category_path(@category), method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, required: true, class: field_classes %>
    </div>
    <div>
      <%= form.label :key, "Key (stable identifier, e.g. wake_up_call)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :key, required: true, class: field_classes %>
    </div>
    <div>
      <%= form.label :department_id, "Department", class: "block text-sm font-medium text-gray-700" %>
      <%= form.collection_select :department_id, @department_options, :id, :name, { include_blank: "— none —" }, class: field_classes %>
    </div>
    <div>
      <%= form.label :icon, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :icon, class: field_classes %>
    </div>
    <div>
      <%= form.label :position, "Display order", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :position, class: field_classes %>
    </div>

    <%= render "detail_fields_fields", param_key: "request_category", selected: @category.detail_fields %>

    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "rounded border-gray-400" %>
      <%= form.label :active, "Active", class: "text-sm text-gray-700" %>
    </div>

    <%= form.submit "Save changes", class: "rounded-md bg-blue-600 px-4 py-2.5 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>
</div>
