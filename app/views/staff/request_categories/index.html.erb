<% content_for :title, "Request categories — #{Current.hotel.name}" %>
<% field_classes = "mt-1 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900">Request categories</h1>
  <%= link_to "← Departments", staff_departments_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <% if @categories.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Category</th>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Department</th>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Details collected</th>
              <th class="px-4 py-3 text-left font-medium text-gray-600">Status</th>
              <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @categories.each do |category| %>
              <tr id="<%= dom_id(category) %>">
                <td class="px-4 py-3">
                  <div class="font-medium text-gray-900"><%= category.name %></div>
                  <div class="text-gray-500"><%= category.key %></div>
                </td>
                <td class="px-4 py-3 text-gray-700"><%= category.department&.name || "—" %></td>
                <td class="px-4 py-3 text-gray-700"><%= category.detail_fields.map(&:humanize).join(", ").presence || "—" %></td>
                <td class="px-4 py-3">
                  <% if category.active? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Inactive</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-3">
                    <% if policy(category).update? %>
                      <%= link_to "Edit", edit_staff_request_category_path(category), class: "font-medium text-blue-600 hover:text-blue-500" %>
                      <%= button_to (category.active? ? "Deactivate" : "Activate"), staff_request_category_path(category),
                            method: :patch, params: { request_category: { active: !category.active? } },
                            class: "font-medium text-amber-700 hover:text-amber-600 cursor-pointer" %>
                    <% end %>
                    <% if policy(category).destroy? %>
                      <%= button_to "Delete", staff_request_category_path(category), method: :delete,
                            form: { data: { turbo_confirm: "Delete #{category.name}?" } },
                            class: "font-medium text-red-600 hover:text-red-500 cursor-pointer" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
        <p class="text-gray-600">No request categories yet — add the first one.</p>
      </div>
    <% end %>
  </div>

  <% if policy(RequestCategory).create? %>
    <div class="lg:col-span-1">
      <section class="rounded-lg border border-gray-200 bg-white p-4">
        <h2 class="text-sm font-medium text-gray-700">Add a request category</h2>

        <% if @category&.errors&.any? %>
          <div class="mt-2 rounded-lg bg-red-50 p-3">
            <ul class="list-inside list-disc text-sm text-red-700">
              <% @category.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @category, url: staff_request_categories_path, class: "mt-3 space-y-3" do |form| %>
          <div>
            <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :name, class: field_classes %>
          </div>
          <div>
            <%= form.label :key, "Key (stable identifier, e.g. wake_up_call)", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :key, class: field_classes %>
          </div>
          <div>
            <%= form.label :department_id, "Department", class: "block text-sm font-medium text-gray-700" %>
            <%= form.collection_select :department_id, @department_options, :id, :name, { include_blank: "— none —" }, class: field_classes %>
          </div>
          <div>
            <%= form.label :icon, class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :icon, class: field_classes %>
          </div>
          <div>
            <%= form.label :position, "Display order", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :position, class: field_classes %>
          </div>
          <%= render "detail_fields_fields", param_key: "request_category", selected: @category.detail_fields %>
          <%= form.submit "Add category", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 cursor-pointer" %>
        <% end %>
      </section>
    </div>
  <% end %>
</div>
