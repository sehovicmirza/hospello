# Local development environment variables.
#
# Copy this file to `.env` (gitignored) and fill in real values there —
# `.env` is loaded automatically in development and test by dotenv-rails
# (see Gemfile). Nothing in THIS file should ever hold a real secret; it
# exists purely to document every variable the app reads and give it a
# one-line explanation. Production values are set on Render (see render.yaml
# and the README's "Deploy to Render" section), never committed here.
#
# Most of these have safe defaults and can stay unset for local dev — see
# the per-variable comments below for which ones actually matter locally.

# ------------------------------------------------------------------------
# App identity
# ------------------------------------------------------------------------

# The public hostname guests reach. Required in production (the app refuses
# to boot without it — see app/services/app_host.rb); not read at all in
# development/test, where QR codes fall back to the current request's host.
# Bare host only — no "https://" scheme, no trailing slash.
APP_HOST=

# ------------------------------------------------------------------------
# Database (production only)
# ------------------------------------------------------------------------

# Full Postgres connection string. Only read in production
# (config/database.yml) — development and test connect to a local Postgres
# by name (hospello_development / hospello_test) with no URL needed. Render
# sets this automatically from the attached database (render.yaml).
DATABASE_URL=

# ------------------------------------------------------------------------
# Rails internals
# ------------------------------------------------------------------------

# Decrypts config/credentials.yml.enc in production. Not needed locally —
# config/master.key (gitignored) covers development/test.
RAILS_MASTER_KEY=

# Puma/ActiveRecord thread and pool count. Also sets the database connection
# pool size (config/database.yml). Defaults to 5.
RAILS_MAX_THREADS=

# Number of Puma worker processes. Leave unset (defaults to 1) unless you
# are testing a multi-worker setup locally.
WEB_CONCURRENCY=

# Puma's listen port. Defaults to 3000.
PORT=

# Puma pidfile path. Unset by default (no pidfile written).
PIDFILE=

# Set by `puma -C config/puma.rb` to run the Solid Queue supervisor inside
# the Puma process instead of a separate worker (config/puma.rb reads this).
# Leave unset locally if you run jobs with `bin/jobs` separately.
SOLID_QUEUE_IN_PUMA=

# Rails log level in production. Defaults to "info"; set to "debug" only
# temporarily — debug level can log request params, which may include PII.
RAILS_LOG_LEVEL=

# Set to any non-blank value to force eager loading in the test environment
# (config/environments/test.rb) — this is what catches autoload/Zeitwerk
# mistakes that only surface once every class is loaded. GitHub Actions sets
# this automatically; you do not need it for a normal local `bin/rails test`.
CI=

# ------------------------------------------------------------------------
# First platform administrator (seeded by db:seed / db:prepare)
# ------------------------------------------------------------------------

# The Hospello operator account that can create hotels. db/seeds.rb creates
# it idempotently (find_or_create_by!) when both EMAIL and PASSWORD are
# present, and skips with a log line — no crash — when either is blank.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Optional; defaults to "Hospello Operator" if unset.
PLATFORM_ADMIN_NAME=

# Set to "1" to also load db/seeds/demo.rb (a demo hotel for presenting the
# product). Currently a stub — populated in a later slice.
SEED_DEMO=

# ------------------------------------------------------------------------
# File storage (hotel logos and welcome images)
# ------------------------------------------------------------------------

# Overrides the automatic local-disk-vs-R2 choice (config/environments/
# production.rb picks "r2" automatically once R2_BUCKET is set, "local"
# otherwise). Only set this to force one or the other regardless of the R2
# variables below. Not read outside production.
ACTIVE_STORAGE_SERVICE=

# Cloudflare R2 (S3-compatible) credentials. Leave all four unset in
# development — uploads use local disk (config/storage.yml's `local`
# service) and never touch these. Required together in production if you
# want uploads to survive a redeploy (local disk there is ephemeral).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# ------------------------------------------------------------------------
# AI concierge (wired in a later slice — safe to leave unset for now)
# ------------------------------------------------------------------------

# Anthropic API key. The `anthropic` gem is in the Gemfile but nothing in
# Slice 1 calls it yet; the app boots and runs fully without this set.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------
# Operations (all optional — every one of these is inert when unset)
# ------------------------------------------------------------------------

# Sentry DSN. Sentry.init only runs when this is present
# (config/initializers/sentry.rb); with it unset, every Sentry.* call
# elsewhere in the app (e.g. Ops::QueueHealthJob) is a documented no-op.
SENTRY_DSN=

# URL an external uptime monitor watches for a heartbeat. Ops::HeartbeatJob
# (config/recurring.yml, every 5 minutes in production) GETs this URL when
# set and no-ops without raising when it's blank — a missing HEARTBEAT_URL
# must never break a deploy.
HEARTBEAT_URL=
